{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/app-v9.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
